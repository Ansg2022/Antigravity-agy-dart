{
  "mcpServers": {
    "fast": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/fast/mcp-server.mjs"
      ],
      "tools": {
        "apply_edits": {
          "eager": true
        },
        "batch_search": {
          "eager": true
        },
        "read_slices": {
          "eager": true
        },
        "run_checks": {
          "eager": true
        }
      }
    },
    "context": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/context/server.js"
      ],
      "timeoutSeconds": 310
    }
  }
}
